# Copy to .env and fill in three DIFFERENT passwords before starting.
# Use unquoted letters/digits/hyphens/underscores (16+ characters recommended).
# .env is read by Docker Compose and Spring Boot and must never be committed.
DB_NAME=matchday
DB_USER=matchday
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
SEED_DEMO_DATA=true
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Optional: set a public project URL/contact for requests to Wikipedia.
# WIKIPEDIA_USER_AGENT=Matchday/1.0 (https://github.com/YOUR_USERNAME/matchday)
